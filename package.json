{
  "name": "shipwarden",
  "version": "0.2.55",
  "private": true,
  "description": "A desktop app that runs many coding agents at the same time, each in its own git worktree.",
  "author": "Austin Chappell",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev -w",
    "dev:fresh": "rm -rf /tmp/sw-fresh && SHIPWARDEN_USER_DATA_DIR=/tmp/sw-fresh npm run dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "check:ios-contract": "sh scripts/check-ios-contract.sh",
    "postinstall": "node scripts/postinstall.mjs",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:dir": "electron-vite build && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/headless": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ghostty-web": "^0.4.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "monaco-editor": "^0.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vscode-languageserver-protocol": "^3.18.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  },
  "dependencies": {
    "@pierre/diffs": "^1.6.4",
    "js-yaml": "^4.3.2",
    "node-pty": "^1.1.0",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.0.3",
    "vscode-jsonrpc": "^10.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "fsevents": false,
    "electron-winstaller": "false"
  },
  "productName": "ShipWarden",
  "build": {
    "appId": "dev.shipwarden.app",
    "productName": "ShipWarden",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@typescript/**",
      "node_modules/typescript-language-server/**"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*",
          "!**/*.test.js"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Austin Chappell (76A95UF226)"
    },
    "dmg": {
      "title": "ShipWarden"
    },
    "electronLanguages": [
      "en"
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
