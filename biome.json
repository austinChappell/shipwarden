{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "plugins/**", "scripts/**", "*.ts", "*.mts", "*.json", "!**/fixtures", "!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noComponentHookFactories": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "useIterableCallbackReturn": "off",
        "noTemplateCurlyInString": "off",
        "noArrayIndexKey": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "noDescendingSpecificity": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "a11y": {
        "useButtonType": "off",
        "noAutofocus": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "noNoninteractiveTabindex": "off",
        "useFocusableInteractive": "off",
        "useMediaCaption": "off",
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Combobox", "InputField"] }
        }
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
